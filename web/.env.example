# STEP SCHOOL KIDS — web
# Copy to .env.local for local development. Never commit real values.

# Trial-lesson form → Google Sheet via Apps Script Web App (see scripts/apps-script/README.md).
# Source of truth for leads. Server-only — never expose to the browser.
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_SECRET=

# Optional second channel: Telegram notification (see src/app/api/trial/route.ts).
TRIAL_TELEGRAM_BOT_TOKEN=
TRIAL_TELEGRAM_CHAT_ID=

# With none of the above set, the form shows the call / Telegram fallback instead of pretending to send.
